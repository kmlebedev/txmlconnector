/logs/
/bin/
# reverse-engineering runs and captures (contain account data)
/.re-run/
*.cap
*.dump

# local IDE state (GoLand), not part of the build
/.idea/
.DS_Store

# repository-local Go cache (used when the sandbox blocks the global cache)
/.cache/

# agent worktrees (DSH create_worktree pool; AGENTS.md §3)
/.agents/
/.worktrees/

# secrets: never commit environment files (use tools/re/demo.env.example)
*.env

# Python caches of the RE tools (generated)
__pycache__/
*.pyc
