<!-- Reference output of the DLL service commands, from a live demo-server session. -->
<!-- Source: txmlconnector64-6.47.2.26.4.dll under Wine 11.21, tools/re/reference-harness, -->
<!-- 2026-11-04; the TCP stream was captured with a logging proxy and the harness callbacks -->
<!-- were saved from $RE_WORKDIR/last-run.out. Session: <connect> with defaults, then -->
<!-- get_server_id, get_servtime_difference, get_markets on the ready connection. -->
<!-- Account data removed: this file keeps only account-independent lines (no login, no -->
<!-- client/union/positions). XML comments mark the commands; callbacks are asynchronous. -->

<!-- get_server_id: replies at once; no network request. The callback carries the SID that -->
<!-- the server issued in the RQ_PWD reply (SID# in the DLL log; 0 on the demo server). -->
<result success="true"/>
<current_server id="0"/>

<!-- get_servtime_difference: the DLL sends RQ_TIME and puts the difference into the result -->
<!-- attribute (no callback). diff = server wall time - local wall time in seconds; on this -->
<!-- host -7200 because local time was UTC+5 and the demo server reports MSK. -->
<result success="true" diff="-7200"/>

<!-- get_markets: replies at once; the worker thread renders the cached RQ_STARTUP -->
<!-- dictionaries (no network request). Names are localized by <connect> language. -->
<result success="true"/>
<markets><market id="0">Collateral</market><market id="1">ММВБ</market><market id="4">FORTS</market><market id="7">SPBEX</market><market id="8">INF</market><market id="9"></market><market id="12"></market><market id="14">MMA</market><market id="15">ETS</market></markets>
