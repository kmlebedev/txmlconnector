# Шаблон окружения для живых проверок TRANSAQ (RE-2/RE-3/RE-4).
#
# Куда положить секреты: СОЗДАЙТЕ КОПИЮ ВНЕ РЕПОЗИТОРИЯ
#
#     cp tools/re/demo.env.example ~/re/demo.env
#     chmod 600 ~/re/demo.env
#     $EDITOR ~/re/demo.env          # заполнить TC_LOGIN и TC_PASSWORD
#
# и перед живыми командами загружайте её в текущую оболочку:
#
#     set -a; . ~/re/demo.env; set +a
#
# Файл ~/re/demo.env содержит учётные данные демо-счёта: он не попадает в git
# (*.env в .gitignore), не копируется в фикстуры/логи/коммиты, значения не печатать.
# Сам этот файл-шаблон безопасен: в нём только имена переменных.

# Демо-счёт TRANSAQ (Finam): значения только в ~/re/demo.env.
TC_LOGIN=
TC_PASSWORD=
TC_HOST=tr1-demo5.finam.ru
TC_PORT=3939

# Wine + эталонная DLL (macOS, Wine 11.21 под Rosetta). Экспорт обязателен:
# tools/re/run_dll.sh берёт WINE/WINEPREFIX/TXC_DLL из окружения (или подставляет
# эти же пути по умолчанию).
export WINE="$HOME/re/wine/Wine Devel.app/Contents/Resources/wine/bin/wine"
export WINEPREFIX="$HOME/re/wine-prefix"
export TXC_DLL="$HOME/GolandProjects/txmlconnector/txmlconnector64-6.47.2.26.4.dll"

# Если запускаете из корня репозитория, TXC_DLL можно задать как $PWD/...:
# export TXC_DLL="$PWD/txmlconnector64-6.47.2.26.4.dll"
